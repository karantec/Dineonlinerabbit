# Copy to .env.local
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/omnibite
JWT_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional). Use SMTP *or* a Google Apps Script webhook.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="OmniBite <no-reply@example.com>"
GAS_EMAIL_WEBHOOK_URL=
